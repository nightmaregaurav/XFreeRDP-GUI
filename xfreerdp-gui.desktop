[Desktop Entry]
Version=1.0
Type=Application
Name=XFreeRDP GUI
GenericName=XFreeRDP GUI
Comment=GUI for XFreeRDP
Exec=xfreerdp-gui
TryExec=xfreerdp-gui
Icon=computer-symbolic
Terminal=false
StartupNotify=true
Categories=Network;RemoteAccess;
Actions=saved;latest;recent;

[Desktop Action saved]
Exec=xfreerdp-gui --saved
Name=Choose a saved connection

[Desktop Action latest]
Exec=xfreerdp-gui --latest
Name=Run most recently saved

[Desktop Action recent]
Exec=xfreerdp-gui --recent
Name=Run most recently used
